<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseAppHost>false</UseAppHost>
    <AuthGoSdkDir>$(MSBuildThisFileDirectory)../../../../sdk/csharp/AuthGo</AuthGoSdkDir>
  </PropertyGroup>
  <ItemGroup><Compile Include="$(AuthGoSdkDir)/AuthGo.Watermark.cs" Visible="false" Condition="'$(PublishTrimmed)' != 'true' And '$(PublishAot)' != 'true' And '$(PublishSingleFile)' != 'true'" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../../../../sdk/csharp/AuthGo/AuthGo.csproj" /></ItemGroup>
</Project>
